PORT=5000
NODE_ENV=development

# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/finora?schema=public"

# JWT secrets — use long random strings, never commit real values
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"

# Frontend origin for CORS + cookies
FRONTEND_URL="http://localhost:5173"

# Google Cloud Translation API; keep this key server-side only
GOOGLE_TRANSLATE_API_KEY=""
GOOGLE_TRANSLATE_API_URL="https://translation.googleapis.com/language/translate/v2"

# Gemini natural-language expense parsing; keep this key server-side only
GEMINI_API_KEY=""

# eSewa ePay v2; keep merchant credentials server-side only
ESEWA_ENV="test"
ESEWA_PRODUCT_CODE=""
ESEWA_SECRET_KEY=""
ESEWA_PLUS_AMOUNT=""
ESEWA_PLUS_DURATION_DAYS=""
